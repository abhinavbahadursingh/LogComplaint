# Groq API — create a token at https://console.groq.com/keys
GROQ_API_KEY=

# Fast model used for field extraction (and default chat)
GROQ_MODEL=llama-3.1-8b-instant

# Conversational assistant model
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Higher-quality model used for the severity/priority risk assessment
GROQ_ASSESSMENT_MODEL=llama-3.3-70b-versatile

# Database — Postgres
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/complaints

# MySQL alternative:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/complaints

# Local dev without a server (comment the lines above):
# DATABASE_URL=sqlite:///./complaints.db